ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxx
# --- Postgres (docker compose reads these automatically) ---
POSTGRES_USER=queryguard
POSTGRES_PASSWORD=changeme
POSTGRES_DB=queryguard
POSTGRES_RO_PASSWORD=changeme

DATABASE_URL=postgresql://queryguard:changeme@localhost:5432/queryguard
DATABASE_URL_READONLY=postgresql://queryguard_ro:changeme@localhost:5432/queryguard

# --- API (python -m queryguard.api); every value below is the default ---
QUERYGUARD_RATE_PER_MINUTE=10
QUERYGUARD_RATE_PER_DAY=50
QUERYGUARD_DAILY_SPEND_USD=1.00
QUERYGUARD_QUESTION_RESERVE_USD=0.05
QUERYGUARD_FRONTEND_ORIGIN=http://localhost:3000
QUERYGUARD_APP_DB=data/app.db
QUERYGUARD_TRUST_PROXY=0
# 1 = answer from src/queryguard/llm/fake.py (golden set), never the API: $0, for UI work
QUERYGUARD_FAKE_LLM=0
QUERYGUARD_FAKE_LLM_DELAY_MS=250
# 0 = kill switch: every question runs in demo mode (the simulated model), $0
QUERYGUARD_LIVE=1
# LLM calls per UTC day for the API; past it, questions fall back to demo mode
QUERYGUARD_DAILY_CALL_CAP=200
# App state in Redis, shared by every instance (production); unset = in-process + SQLite.
# `docker compose up -d redis` gives a local one: redis://localhost:6379/0
# QUERYGUARD_REDIS_URL=
# QUERYGUARD_STATE_PREFIX=qg:
# Process-lifetime runaway guard (default 50 calls, ~12 questions). A long-running
# server should raise it; the daily spend ceiling above is the real control.
# QUERYGUARD_MAX_REQUESTS=50
