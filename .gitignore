# Secrets — never commit
.env
.env.*
!.env.example
# Editor swap and lock files: vim/nano name the one for .env.neon "..env.neon.swp",
# which `.env.*` does not match, and it can hold the file's contents.
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Data & logs
*.db
*.sqlite3
logs/
*.log

# OS / editor
.DS_Store
.idea/
.vscode/

# Regenerable introspection artifact, derived from the local database.
schema_cache.json

# LLM call logs — may contain question text and cost data.
logs/

# Eval dry runs: fake-client output, never calibration data.
evals/results/dryrun*

# Private Claude Code notes
CLAUDE.local.md

# API state: history, feedback, cache (SQLite). Holds demo users' questions.
data/
# Exported from that feedback; review, then move entries into golden.yaml.
evals/feedback_candidates.yaml
